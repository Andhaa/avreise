[Unit]
Description=Avreise weather display
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=umbrella-signage
Group=umbrella-signage
WorkingDirectory=/opt/umbrella-signage
EnvironmentFile=-/etc/default/umbrella-signage
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=BASE_PATH=/umbrella
Environment=WEATHER_MODE=live
ExecStart=/usr/bin/node /opt/umbrella-signage/server.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/umbrella-signage
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M

[Install]
WantedBy=multi-user.target
